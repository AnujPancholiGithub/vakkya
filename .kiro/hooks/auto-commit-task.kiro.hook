{
  "enabled": true,
  "name": "Auto-commit on Task Completion",
  "description": "Automatically stages all modified files and creates a git commit with a conventional commit message (feat:, fix:, etc.) that summarizes the completed task and changes made",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Automatically stage all modified files and create a git commit using a proper conventional commit prefix (feat:, fix:, etc.).\nThe commit message should summarize the completed task and the changes made.\nUse the latest information in STATUS.md to ensure the commit message reflects the most recent task completion status."
  },
  "workspaceFolderName": "vakkya_v1",
  "shortName": "auto-commit-task"
}