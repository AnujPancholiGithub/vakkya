{
  "name": "@vakkya/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:full": "bash scripts/migrate.sh",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-prisma.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^6.1.0",
    "@vakkya/schemas": "workspace:*",
    "bcrypt": "^5.1.1",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.7",
    "openai": "^4.77.3",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/form-data": "^2.5.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "fast-check": "^4.3.0",
    "form-data": "^4.0.5",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
