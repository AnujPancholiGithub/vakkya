// Prisma schema for Vakkya API Server
// PostgreSQL with pgvector extension for vector embeddings

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // Hashed with bcrypt
  createdAt DateTime  @default(now())
  projects  Project[]

  @@map("users")
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  name          String
  widgetToken   String         @unique
  systemPrompt  String?        @db.Text // Custom agent instructions (max 2000 chars)
  agentName     String?        // Custom agent name, e.g., "Sarah from Acme"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations Conversation[]
  formSchemas   FormSchema[]

  @@index([userId])
  @@index([widgetToken])
  @@map("projects")
}

model Document {
  id           String          @id @default(cuid())
  projectId    String
  filename     String
  fileType     String
  filePath     String          // Local file path
  status       String          @default("uploading")
  errorMessage String?
  createdAt    DateTime        @default(now())
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([projectId])
  @@map("documents")
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  projectId  String
  chunkIndex Int
  text       String                 @db.Text
  embedding  Unsupported("vector")? // pgvector type (1536 dimensions)
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([projectId])
  @@map("document_chunks")
}

model Conversation {
  id              String             @id @default(cuid())
  projectId       String
  sessionId       String
  startedAt       DateTime           @default(now())
  turnCount       Int                @default(0)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  turns           ConversationTurn[]
  formSubmissions FormSubmission[]
  formEvents      FormEvent[]

  @@index([projectId])
  @@index([sessionId])
  @@map("conversations")
}

model ConversationTurn {
  id             String       @id @default(cuid())
  conversationId String
  userQuery      String       @db.Text
  agentResponse  String       @db.Text
  timestamp      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_turns")
}

model FormSchema {
  id                String            @id @default(cuid())
  projectId         String
  name              String
  description       String?           @db.Text // Help text for agent understanding
  fields            Json              // [{name, type, label, required, options?}]
  triggerPhrases    String[]          @default([]) // Natural language patterns to activate form
  greetingMessage   String?           @db.Text // Custom message when form starts
  completionMessage String?           @db.Text // Custom message after submission
  webhookUrl        String?           @db.Text
  webhookSecret     String?           // Optional secret for HMAC signing
  isActive          Boolean           @default(true) // Whether form is available to agent
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions       FormSubmission[]
  events            FormEvent[]

  @@index([projectId])
  @@index([projectId, isActive])
  @@map("form_schemas")
}

model FormSubmission {
  id              String       @id @default(cuid())
  formSchemaId    String
  sessionId       String
  conversationId  String?      // Link to conversation for analytics
  data            Json         // {name: "John", email: "john@x.com"}
  webhookSent     Boolean      @default(false)
  webhookAttempts Int          @default(0) // Number of webhook delivery attempts
  status          String       @default("pending") // pending, completed, failed
  createdAt       DateTime     @default(now())
  formSchema      FormSchema   @relation(fields: [formSchemaId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([formSchemaId])
  @@index([sessionId])
  @@index([conversationId])
  @@map("form_submissions")
}

model FormEvent {
  id             String       @id @default(cuid())
  formSchemaId   String
  conversationId String?
  sessionId      String
  eventType      String       // activated, field_collected, submitted, abandoned
  fieldName      String?      // For field_collected events
  fieldValue     String?      @db.Text // For field_collected events
  attemptCount   Int?         // Number of attempts for this field
  metadata       Json?        // Additional context (trigger reason, error details, etc.)
  timestamp      DateTime     @default(now())
  formSchema     FormSchema   @relation(fields: [formSchemaId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([formSchemaId])
  @@index([conversationId])
  @@index([sessionId])
  @@index([eventType])
  @@map("form_events")
}
