# LiveKit Configuration
# LiveKit Inference provides STT, LLM, and TTS - no other API keys needed!
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Database Configuration (shared with API server)
DATABASE_URL=postgresql://user:password@localhost:5432/vakkya

# OpenAI Configuration (optional - only needed for RAG in Phase 4)
# OPENAI_API_KEY=your_openai_api_key

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Server Configuration (for conversation logging)
API_SERVER_URL=http://localhost:3000
